export PATCHMON_ENROLLMENT_KEY='<your-enrollment-key>'
export PATCHMON_ENROLLMENT_SECRET='<your-enrollment-secret>'
export PATCHMON_API_KEY='<your-api-key>'
export PATCHMON_API_SECRET='<your-api-secret>'

# Preferred. The enrollment and Integration hosts URLs are derived from this.
export PATCHMON_SERVER_URL=https://patchmon.example.com

# Discouraged overrides. Uncomment only when the derived URLs are wrong.
# Prefer PATCHMON_SERVER_URL and leave these unset.
# export PATCHMON_ENROLLMENT_URL=https://enroll.example.com/api/v1/auto-enrollment
# export PATCHMON_API_URL=https://api.example.com/api/v1/api/hosts

# TLS certificate verification. true is the default. false is for a lab only.
# export PATCHMON_VERIFY_SSL=true
# export PATCHMON_VERIFY_SSL=false

# Derive when the overrides above are unset.
_patchmon_server="${PATCHMON_SERVER_URL%/}"
if [[ -n "${_patchmon_server}" ]]; then
  export PATCHMON_ENROLLMENT_URL="${PATCHMON_ENROLLMENT_URL:-${_patchmon_server}/api/v1/auto-enrollment}"
  export PATCHMON_API_URL="${PATCHMON_API_URL:-${_patchmon_server}/api/v1/api/hosts}"
fi
unset _patchmon_server
