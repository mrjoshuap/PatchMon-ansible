import os

extensions.extend(["myst_parser", "sphinxcontrib.mermaid"])

myst_enable_extensions = ["colon_fence", "deflist", "tasklist"]
# Relative .html links are sibling docsite pages. MyST otherwise turns them
# into a heading on the current page.
myst_all_links_external = True
myst_fence_as_directive = ["mermaid"]
myst_heading_anchors = 3
suppress_warnings = ["myst.xref_missing", "myst.header"]

mermaid_version = "11.4.1"
mermaid_init_js = """
mermaid.initialize({
  startOnLoad: true,
  theme: "dark",
  themeVariables: {
    primaryColor: "#14532d",
    primaryTextColor: "#f1f5f9",
    primaryBorderColor: "#22c55e",
    lineColor: "#22c55e",
    secondaryColor: "#1e293b",
    tertiaryColor: "#0f172a",
    background: "#020617",
    mainBkg: "#14532d",
    nodeBorder: "#22c55e",
    clusterBkg: "#0f172a",
    titleColor: "#f1f5f9",
    edgeLabelBackground: "#1e293b"
  }
});
"""

html_theme_options["style_nav_header_background"] = "#020617"

_static = os.path.abspath(
    os.path.join(os.path.dirname(__file__), "..", "docs", "docsite", "_static")
)
html_static_path = [_static]
html_css_files = ["patchmon.css"]
html_favicon = os.path.join(_static, "favicon.svg")
# The Ansible theme includes banner.html at the top of every page.
_templates = os.path.abspath(
    os.path.join(os.path.dirname(__file__), "..", "docs", "docsite", "_templates")
)
templates_path = [_templates]


def _insert_markdown(app, docname, source):
    """Insert rewritten Markdown after rstcheck has already linted the stub pages."""
    pages = {
        "docsite/readme": (
            "README.md",
            "Ansible Collection - patchmon.core",
        ),
        "docsite/changelog": ("CHANGELOG.md", "Changelog"),
        "docsite/proposal": ("PROPOSAL.md", "Proposal"),
    }
    page = pages.get(docname)
    if page is not None:
        filename, title = page
        # Relative to built-docs/rst/docsite/. A leading slash is the Sphinx source
        # root, so this cannot be an absolute filesystem path.
        included = os.path.join("..", "..", "..", "built-docs", "included", filename)
        label = next(
            (line for line in source[0].splitlines() if line.startswith(".. _")),
            "",
        )
        source[0] = (
            f"{label}\n\n{title}\n{'=' * len(title)}\n\n"
            f".. include:: {included}\n   :parser: myst_parser.sphinx_\n"
        )


def setup(app):
    app.connect("source-read", _insert_markdown)
