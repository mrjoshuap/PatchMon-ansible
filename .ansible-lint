---
# ansible-lint for example and collection playbooks / roles.
profile: basic
exclude_paths:
  - .git/
  - .github/
  - tests/
  - .pytest_cache/
  - .collections/
  - .pytest_collections/
  - .ansible/
skip_list:
  # Examples intentionally demonstrate debug output.
  - name[casing]
warn_list:
  - experimental
